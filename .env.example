# =============================================================================
# PC Builders Canada — environment variables
# =============================================================================
# Copy to .env.local for development:   cp .env.example .env.local
# .env.local is gitignored. Never commit real keys.
#
# The application runs with NONE of these set: the catalogue falls back to the
# local sample data, accounts are disabled, and checkout refuses to start and
# says so. Fill these in to turn each capability on.
# =============================================================================

# --- Site ---------------------------------------------------------------
# Public base URL. Used for canonical URLs, the sitemap, OG tags and the
# Stripe return URLs. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (database + auth) ----------------------------------------
# Project Settings -> API in the Supabase dashboard.
# The anon key is public by design; Row Level Security is what protects data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Bypasses Row Level Security. Used by the Stripe webhook and
# audited admin writes. Never expose this to the browser, never prefix it with
# NEXT_PUBLIC_, and never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (payments) --------------------------------------------------
# Use TEST keys (sk_test_... / pk_test_...) everywhere except production.
# The app refuses to boot with a live secret key outside production.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# From `stripe listen` locally, or the endpoint's signing secret in the
# Stripe dashboard for a deployed environment. Without it the webhook
# rejects every request, which is the correct failure mode.
STRIPE_WEBHOOK_SECRET=

# --- Email (optional) ---------------------------------------------------
# Transactional email. If these are unset, the app logs what it WOULD have
# sent and reports the notification as not delivered. It does not pretend.
RESEND_API_KEY=
EMAIL_FROM="PC Builders Canada <orders@example.com>"
ADMIN_NOTIFICATION_EMAIL=
